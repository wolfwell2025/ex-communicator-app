# Template for environment variables. Prefer .env.local locally.
# Never commit real secrets.

# Canonical public origin for auth email redirects (required in production)
NEXT_PUBLIC_SITE_URL=https://ex-communicator-app.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias for older SDK/docs that expect ANON:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role (placeholder — do not invent or commit a real key)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI tone coaching rewrite (server-only). Heuristic rewrite works without these.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Calendar OAuth (server-only secret + public client id)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional AES key for stored tokens (defaults to GOOGLE_CLIENT_SECRET if unset)
# CALENDAR_TOKEN_SECRET=
# Optional override; default is {NEXT_PUBLIC_SITE_URL}/api/calendar/google/callback
# GOOGLE_REDIRECT_URI=

# Google Maps / Places autocomplete (browser-safe; restrict by HTTP referrer)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Outlook / Microsoft 365 Calendar OAuth (server-only)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Optional tenant (default common = work/school + personal Microsoft accounts)
# MICROSOFT_TENANT_ID=common
# Optional override; default is {NEXT_PUBLIC_SITE_URL}/api/calendar/outlook/callback
# MICROSOFT_REDIRECT_URI=

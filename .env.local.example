# Copy to .env.local for local development (never commit .env.local).

# Canonical public origin for auth email redirects.
# Locally you can use http://localhost:3000; on Vercel set the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key from Supabase Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional alias: some older examples/SDK snippets expect ANON.
# Set it to the same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if needed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Do not expose to the browser. Leave blank until you need admin APIs.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI tone coaching rewrite (server-only). Heuristic rewrite works without these.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Copy to .env.local for local development (never commit .env.local).

# Canonical public origin for auth email redirects.
# Locally you can use http://localhost:3000; on Vercel set the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key from Supabase Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional alias: some older examples/SDK snippets expect ANON.
# Set it to the same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if needed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Do not expose to the browser. Leave blank until you need admin APIs.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI tone coaching rewrite (server-only). Heuristic rewrite works without these.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Calendar OAuth — see GOOGLE-SETUP.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CALENDAR_TOKEN_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Places autocomplete (optional; UI degrades to plain text without it)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Outlook / Microsoft 365 Calendar
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Email intake (Gmail + Outlook mail) — see EMAIL-INTAKE-SETUP.md
# Reuses GOOGLE_* and MICROSOFT_* client credentials from Calendar.
# GMAIL_REDIRECT_URI=http://localhost:3000/api/email/gmail/callback
# MICROSOFT_MAIL_REDIRECT_URI=http://localhost:3000/api/email/outlook/callback

